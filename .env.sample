# MCP RAG Server 環境変数設定ファイル
# このファイルを .env にコピーして、必要な値を設定してください

# ===============================
# PostgreSQL データベース設定
# ===============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ragdb

# ===============================
# ディレクトリ設定
# ===============================
# 処理対象のソースファイルが保存されるディレクトリ
SOURCE_DIR=./data/source

# 処理済みファイルが保存されるディレクトリ
PROCESSED_DIR=./data/processed

# ===============================
# 埋め込みモデル設定
# ===============================
# 使用する埋め込みモデル (HuggingFace model ID)
EMBEDDING_MODEL=intfloat/multilingual-e5-large


# ===============================
# データマスキング設定
# ===============================
# データマスキング機能を無効にする場合は "false" に設定
# デフォルト: true
MASKING_ENABLED=true

# ===============================
# カスタムマスキングルール設定
# ===============================
# 環境変数でカスタムマスキングルールを定義できます
# 形式: MASK_RULE_<ルール名>_<フィールド>=<値>
#
# 必須フィールド:
# - PATTERN: マスキング対象の正規表現パターン
# - REPLACEMENT: 置換後の文字列
#
# オプションフィールド:
# - DESCRIPTION: ルールの説明

# 例1: 会社名のマスキング
# MASK_RULE_COMPANY_PATTERN=株式会社[^\s]+
# MASK_RULE_COMPANY_REPLACEMENT=[MASKED_COMPANY]
# MASK_RULE_COMPANY_DESCRIPTION=会社名

# 例2: 従業員番号のマスキング
# MASK_RULE_EMPLOYEE_PATTERN=EMP-\d{4,6}
# MASK_RULE_EMPLOYEE_REPLACEMENT=[MASKED_EMPLOYEE_ID]
# MASK_RULE_EMPLOYEE_DESCRIPTION=従業員番号

# 例3: 顧客IDのマスキング
# MASK_RULE_CUSTOMER_PATTERN=CUST-[A-Z0-9]{8}
# MASK_RULE_CUSTOMER_REPLACEMENT=[MASKED_CUSTOMER_ID]
# MASK_RULE_CUSTOMER_DESCRIPTION=顧客ID

# 例4: プロダクトキーのマスキング
# MASK_RULE_PRODUCTKEY_PATTERN=[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}
# MASK_RULE_PRODUCTKEY_REPLACEMENT=[MASKED_PRODUCT_KEY]
# MASK_RULE_PRODUCTKEY_DESCRIPTION=プロダクトキー

# 例5: 銀行口座番号のマスキング
# MASK_RULE_BANKACCOUNT_PATTERN=\d{7}-\d{1}
# MASK_RULE_BANKACCOUNT_REPLACEMENT=[MASKED_BANK_ACCOUNT]
# MASK_RULE_BANKACCOUNT_DESCRIPTION=銀行口座番号

# ===============================
# デフォルトマスキングルール（参考情報）
# ===============================
# 以下のルールがデフォルトで有効になります（MASKING_ENABLED=trueの場合）:
#
# 1. email: メールアドレス → [MASKED_EMAIL]
# 2. phone_jp: 日本の電話番号 → [MASKED_PHONE]
# 3. credit_card: クレジットカード番号 → [MASKED_CREDIT_CARD]
# 4. social_security_jp: マイナンバー → [MASKED_SSN]
# 5. ip_address: IPアドレス → [MASKED_IP]
# 6. url: URL → [MASKED_URL]
